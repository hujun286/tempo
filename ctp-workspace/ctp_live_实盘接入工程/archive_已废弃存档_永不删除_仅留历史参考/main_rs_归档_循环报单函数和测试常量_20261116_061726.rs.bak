// 归档：以下内容从 src/main.rs 移除，仅留历史参考。
// 包含：5 个循环报单测试函数、5 个硬编码测试常量、守卫函数。
// 移除原因：循环报单不接硬保险；常量是仿真遗留。

fn run_test_2_2(api: &TraderApi, rx: &Receiver<Event>) -> Result<(), Box<dyn std::error::Error>> {
    require_loop_trading_allowed()?;
    if wait_event(rx, Duration::from_secs(10), |e| matches!(e, Event::Connected)).is_none() {
        return Err("10 秒内未连接".into());
    }
    println!("=== 已连接 ===");
    let (_front_id, _session_id) = open_session(api, rx)?;

    // 报单
    let mut order = CThostFtdcInputOrderField::default();
    copy_str(&mut order.BrokerID, broker());
    copy_str(&mut order.InvestorID, user());
    copy_str(&mut order.InstrumentID, INSTRUMENT);
    copy_str(&mut order.ExchangeID, EXCHANGE);
    copy_str(&mut order.OrderRef, ORDER_REF);
    order.Direction = THOST_FTDC_D_Buy as i8;
    order.CombOffsetFlag[0] = THOST_FTDC_OF_Open as i8;
    order.CombHedgeFlag[0] = THOST_FTDC_HF_Speculation as i8;
    order.OrderPriceType = THOST_FTDC_OPT_LimitPrice as i8;
    order.LimitPrice = LIMIT_PRICE;
    order.VolumeTotalOriginal = VOLUME;
    order.TimeCondition = THOST_FTDC_TC_GFD as i8;
    order.VolumeCondition = THOST_FTDC_VC_AV as i8;
    order.ContingentCondition = THOST_FTDC_CC_Immediately as i8;
    order.ForceCloseReason = THOST_FTDC_FCC_NotForceClose as i8;
    order.IsAutoSuspend = 0;
    order.UserForceClose = 0;

    println!("[INSERT REQ] ret={}", api.req_order_insert(&mut order, 10));

    let mut sys_id = String::new();
    let deadline = Instant::now() + Duration::from_secs(15);
    loop {
        let remaining = deadline.saturating_duration_since(Instant::now());
        if remaining.is_zero() { break; }
        match rx.recv_timeout(remaining) {
            Ok(Event::RtnOrder { sys_id: s, status, traded, total }) => {
                println!("[RtnOrder] sys_id={:?} status={} traded={} total={}", s, status, traded, total);
                if !s.is_empty() { sys_id = s; break; }
            }
            Ok(Event::RtnTrade { price, volume }) => println!("[RtnTrade] 成交 price={} volume={}", price, volume),
            Ok(Event::InsertRsp(Some((id, m)))) => return Err(format!("报单被拒: {} {}", id, m).into()),
            Ok(Event::ErrRtnInsert(Some((id, m)))) => return Err(format!("报单错误回报: {} {}", id, m).into()),
            Ok(_) => {}
            Err(_) => break,
        }
    }
    if sys_id.is_empty() { return Err("未收到有效委托回报".into()); }
    println!("[ORDER ACCEPTED] sys_id={}", sys_id);

    // 撤单（SHFE 本地会话定位）
    let mut action = CThostFtdcInputOrderActionField::default();
    copy_str(&mut action.BrokerID, broker());
    copy_str(&mut action.InvestorID, user());
    copy_str(&mut action.InstrumentID, INSTRUMENT);
    copy_str(&mut action.ExchangeID, EXCHANGE);
    copy_str(&mut action.OrderRef, ORDER_REF);
    action.FrontID = _front_id;
    action.SessionID = _session_id;
    action.ActionFlag = THOST_FTDC_AF_Delete as i8;
    println!("[ACTION] FrontID={} SessionID={} OrderRef={} sys_id={}",
             action.FrontID, action.SessionID, ORDER_REF, sys_id);
    println!("[ACTION REQ] ret={}", api.req_order_action(&mut action, 11));

    let deadline = Instant::now() + Duration::from_secs(15);
    let mut cancelled = false;
    loop {
        let remaining = deadline.saturating_duration_since(Instant::now());
        if remaining.is_zero() { break; }
        match rx.recv_timeout(remaining) {
            Ok(Event::RtnOrder { sys_id: s, status, .. }) => {
                println!("[RtnOrder] sys_id={:?} status={}", s, status);
                if status == THOST_FTDC_OST_Canceled as i8 { cancelled = true; break; }
            }
            Ok(Event::RtnTrade { price, volume }) => println!("[RtnTrade] 撤单期间成交 price={} volume={}", price, volume),
            Ok(Event::ActionRsp(Some((id, m)))) => return Err(format!("撤单被拒: {} {}", id, m).into()),
            Ok(Event::ErrRtnAction(Some((id, m)))) => return Err(format!("撤单错误回报: {} {}", id, m).into()),
            Ok(_) => {}
            Err(_) => break,
        }
    }
    if cancelled { println!("[CANCEL CONFIRMED] 状态已撤"); }
    else { eprintln!("[CANCEL TIMEOUT] 未收到已撤回报"); }

    println!("=== 2.2 Rust 版完成 ===");
    Ok(())
}

// ============ 2.5 断线重连 ============
// 测试点映射：
//   T1 = 连接成功
//   T2 = 连接断开
//   T3 = 重连成功
// 使用方法：
//   1) CTP_TEST=2.5 cargo run
//   2) 看到 [2.5-T1] 后截屏
//   3) 看到 [READY] 后手动断网（拔网线/关 WiFi）5 秒
//   4) 看到 [2.5-T2] 后截屏
//   5) 恢复网络，等 [2.5-T3] 出现后截屏
//   6) Ctrl+C 退出


fn run_test_2_5(api: &TraderApi, rx: &Receiver<Event>) -> Result<(), Box<dyn std::error::Error>> {
    require_loop_trading_allowed()?;
    let t0 = Instant::now();
    let mut count = 0u32;

    'outer: loop {
        // 阶段 A：等连接
        loop {
            match rx.recv_timeout(Duration::from_secs(120)) {
                Ok(Event::Connected) => {
                    count += 1;
                    let t = t0.elapsed().as_secs_f64();
                    if count == 1 {
                        println!("[2.5-T1] 连接成功  t=+{:.2}s", t);
                    } else {
                        println!("[2.5-T3] 重连成功  t=+{:.2}s（第{}次连接）", t, count);
                    }
                    break;
                }
                Ok(Event::Disconnected) => {
                    println!("[2.5-T2] 连接断开  t=+{:.2}s", t0.elapsed().as_secs_f64());
                }
                Ok(_) => {}
                Err(_) => return Err("120 秒内未收到 Connected".into()),
            }
        }

        // 阶段 B：会话（认证/登录/结算）
        if let Err(e) = open_session(api, rx) {
            eprintln!("[SESSION FAIL] {}", e);
            continue 'outer;
        }

        // 阶段 C：已就绪，等断线
        println!("[READY] 第{}次会话就绪。可手动断网测试 2.5，Ctrl+C 退出。", count);
        loop {
            match rx.recv() {
                Ok(Event::Disconnected) => {
                    println!("[2.5-T2] 连接断开  t=+{:.2}s", t0.elapsed().as_secs_f64());
                    continue 'outer;
                }
                Ok(_) => {}
                Err(_) => return Ok(()),
            }
        }
    }
}


// ============ 2.6 报撤单计数 + 2.8 阈值预警 ============


fn run_test_2_6(api: &TraderApi, rx: &Receiver<Event>) -> Result<(), Box<dyn std::error::Error>> {
    require_loop_trading_allowed()?;
    if wait_event(rx, Duration::from_secs(10), |e| matches!(e, Event::Connected)).is_none() {
        return Err("10 秒内未连接".into());
    }
    println!("=== 2.6 已连接 ===");
    let (front_id, session_id) = open_session(api, rx)?;

    let order_threshold = 2;
    let cancel_threshold = 2;
    let mut order_count = 0;
    let mut cancel_count = 0;

    for i in 1..=3 {
        let order_ref = i.to_string();

        let mut order = CThostFtdcInputOrderField::default();
        copy_str(&mut order.BrokerID, broker());
        copy_str(&mut order.InvestorID, user());
        copy_str(&mut order.InstrumentID, INSTRUMENT);
        copy_str(&mut order.ExchangeID, EXCHANGE);
        copy_str(&mut order.OrderRef, order_ref.as_str());
        order.Direction = THOST_FTDC_D_Buy as i8;
        order.CombOffsetFlag[0] = THOST_FTDC_OF_Open as i8;
        order.CombHedgeFlag[0] = THOST_FTDC_HF_Speculation as i8;
        order.OrderPriceType = THOST_FTDC_OPT_LimitPrice as i8;
        order.LimitPrice = LIMIT_PRICE;
        order.VolumeTotalOriginal = VOLUME;
        order.TimeCondition = THOST_FTDC_TC_GFD as i8;
        order.VolumeCondition = THOST_FTDC_VC_AV as i8;
        order.ContingentCondition = THOST_FTDC_CC_Immediately as i8;
        order.ForceCloseReason = THOST_FTDC_FCC_NotForceClose as i8;
        order.IsAutoSuspend = 0;
        order.UserForceClose = 0;

        println!("\n[INSERT #{}] ref={}", i, order_ref);
        let ret = api.req_order_insert(&mut order, 10 + i as i32);
        if ret != 0 { return Err(format!("req_order_insert 失败 ret={}", ret).into()); }

        let mut sys_id = String::new();
        let deadline = Instant::now() + Duration::from_secs(10);
        loop {
            let remaining = deadline.saturating_duration_since(Instant::now());
            if remaining.is_zero() { break; }
            match rx.recv_timeout(remaining) {
                Ok(Event::RtnOrder { sys_id: s, status, .. }) => {
                    println!("[RtnOrder] sys_id={:?} status={}", s, status);
                    if !s.is_empty() { sys_id = s; break; }
                }
                Ok(Event::InsertRsp(Some((id, m)))) => {
                    return Err(format!("报单被拒: {} {}", id, m).into());
                }
                Ok(_) => {}
                Err(_) => break,
            }
        }
        if sys_id.is_empty() { return Err("未收到委托回报".into()); }

        order_count += 1;
        println!("[COUNT] 报单笔数={} (阈值={})", order_count, order_threshold);
        if order_count >= order_threshold {
            println!("[ALERT] 报单笔数达到阈值！当前={} 阈值={}", order_count, order_threshold);
        }

        let mut action = CThostFtdcInputOrderActionField::default();
        copy_str(&mut action.BrokerID, broker());
        copy_str(&mut action.InvestorID, user());
        copy_str(&mut action.InstrumentID, INSTRUMENT);
        copy_str(&mut action.ExchangeID, EXCHANGE);
        copy_str(&mut action.OrderRef, order_ref.as_str());
        action.FrontID = front_id;
        action.SessionID = session_id;
        action.ActionFlag = THOST_FTDC_AF_Delete as i8;

        println!("[ACTION #{}] FrontID={} SessionID={} OrderRef={}", i, front_id, session_id, order_ref);
        let ret = api.req_order_action(&mut action, 20 + i as i32);
        if ret != 0 { return Err(format!("req_order_action 失败 ret={}", ret).into()); }

        let deadline = Instant::now() + Duration::from_secs(10);
        loop {
            let remaining = deadline.saturating_duration_since(Instant::now());
            if remaining.is_zero() { break; }
            match rx.recv_timeout(remaining) {
                Ok(Event::RtnOrder { status, .. }) if status == THOST_FTDC_OST_Canceled as i8 => break,
                Ok(Event::ActionRsp(Some((id, m)))) => {
                    return Err(format!("撤单被拒: {} {}", id, m).into());
                }
                Ok(_) => {}
                Err(_) => break,
            }
        }

        cancel_count += 1;
        println!("[COUNT] 撤单笔数={} (阈值={})", cancel_count, cancel_threshold);
        if cancel_count >= cancel_threshold {
            println!("[ALERT] 撤单笔数达到阈值！当前={} 阈值={}", cancel_count, cancel_threshold);
        }
    }

    println!("\n=== 2.6 报撤单计数 + 2.8 阈值预警 完成 ===");
    println!("最终: 报单 {} 笔，撤单 {} 笔", order_count, cancel_count);
    Ok(())
}


// ============ 2.9 指令检查 + 2.10 错误提示 ============


fn run_test_2_9_2_10(api: &TraderApi, rx: &Receiver<Event>) -> Result<(), Box<dyn std::error::Error>> {
    require_loop_trading_allowed()?;
    if wait_event(rx, Duration::from_secs(10), |e| matches!(e, Event::Connected)).is_none() {
        return Err("10 秒内未连接".into());
    }
    println!("=== 2.9+2.10 已连接 ===");
    let (_f, _s) = open_session(api, rx)?;

    println!("\n========== 2.9 交易指令检查 ==========");

    println!("\n>>> 2.9-1 合约代码错误（al9999）");
    try_insert(api, rx, 101, "al9999", 22550.0, 1,
               THOST_FTDC_D_Buy as i8, THOST_FTDC_OF_Open, "2.9-1 错合约");
    std::thread::sleep(Duration::from_secs(3));

    println!("\n>>> 2.9-2 最小变动价位错误（al2612 价格 22552，最小变动 5）");
    try_insert(api, rx, 102, "al2612", 22552.0, 1,
               THOST_FTDC_D_Buy as i8, THOST_FTDC_OF_Open, "2.9-2 错价格");
    std::thread::sleep(Duration::from_secs(3));

    println!("\n>>> 2.9-3 超单笔最大手数（al2612 10000 手）");
    try_insert(api, rx, 103, "al2612", 22550.0, 10000,
               THOST_FTDC_D_Buy as i8, THOST_FTDC_OF_Open, "2.9-3 超手数");
    std::thread::sleep(Duration::from_secs(3));

    println!("\n========== 2.10 错误提示 ==========");

    println!("\n>>> 2.10-1 资金不足（连续报单耗尽可用资金）");
    let mut successful_refs = Vec::new();
    for i in 0..100 { // 最多报 100 次，每次 100 手（避开164数量限制）
        let ref_str = format!("{}", 200 + i);
        let mut order = CThostFtdcInputOrderField::default();
        copy_str(&mut order.BrokerID, broker());
        copy_str(&mut order.InvestorID, user());
        copy_str(&mut order.InstrumentID, "al2612");
        copy_str(&mut order.ExchangeID, EXCHANGE);
        copy_str(&mut order.OrderRef, &ref_str);
        order.Direction = THOST_FTDC_D_Buy as i8;
        order.CombOffsetFlag[0] = THOST_FTDC_OF_Open as i8;
        order.CombHedgeFlag[0] = THOST_FTDC_HF_Speculation as i8;
        order.OrderPriceType = THOST_FTDC_OPT_LimitPrice as i8;
        order.LimitPrice = 22550.0; // 挂在跌停附近，不会成交，只冻结资金
        order.VolumeTotalOriginal = 100;
        order.TimeCondition = THOST_FTDC_TC_GFD as i8;
        order.VolumeCondition = THOST_FTDC_VC_AV as i8;
        order.ContingentCondition = THOST_FTDC_CC_Immediately as i8;
        order.ForceCloseReason = THOST_FTDC_FCC_NotForceClose as i8;
        order.IsAutoSuspend = 0;
        order.UserForceClose = 0;

        let ret = api.req_order_insert(&mut order, 300 + i);
        if ret != 0 { println!("req ret={}", ret); }

        let deadline = Instant::now() + Duration::from_secs(3);
        let mut got_err = false;
        loop {
            let remaining = deadline.saturating_duration_since(Instant::now());
            if remaining.is_zero() { break; }
            match rx.recv_timeout(remaining) {
                Ok(Event::InsertRsp(Some((id, m)))) => {
                    println!("  ✅ 柜台拒绝(资金不足) ErrorID={} Msg={}", id, m);
                    got_err = true;
                    break;
                }
                Ok(Event::RtnOrder { sys_id, .. }) if !sys_id.is_empty() => {
                    successful_refs.push((ref_str, sys_id));
                    println!("  第 {} 笔(100手) 报单成功并冻结资金", i+1);
                    break;
                }
                Ok(_) => {}
                Err(_) => break,
            }
        }
        if got_err { break; } // 遇到资金不足即停止
    }
    // 撤掉刚才为了测试资金不足而挂的单子
    println!("\n  >>> 清理刚才冻结资金的单子...");
    for (r, _sys) in successful_refs {
        let mut action = CThostFtdcInputOrderActionField::default();
        copy_str(&mut action.BrokerID, broker());
        copy_str(&mut action.InvestorID, user());
        copy_str(&mut action.InstrumentID, "al2612");
        copy_str(&mut action.ExchangeID, EXCHANGE);
        copy_str(&mut action.OrderRef, &r);
        action.ActionFlag = THOST_FTDC_AF_Delete as i8;
        api.req_order_action(&mut action, 999);
    }
    std::thread::sleep(Duration::from_secs(3));

    println!("\n>>> 2.10-2 持仓不足（al2612 卖平今 1 手，无持仓）");
    try_insert(api, rx, 105, "al2612", 22550.0, 1,
               THOST_FTDC_D_Sell as i8, THOST_FTDC_OF_CloseToday, "2.10-2 持仓不足");
    std::thread::sleep(Duration::from_secs(3));

    println!("\n>>> 2.10-3 市场状态不允许");
    println!("  盘中无法构造，需在非交易时段报单。");
    println!("  建议：22日 03:00 后（白银夜盘收盘）或白天收盘后重跑 2.9 模式，");
    println!("  把合约改成已收盘的 ag2612，柜台会返回市场状态错误。");

    println!("\n=== 2.9+2.10 全部 case 完成 ===");
    println!("请把每个 case 的 ErrorID 和 Msg 记录到报告 2.9/2.10 证据表");
    Ok(())
}


// ============ 2.11 暂停交易 + 2.12 批量撤单 + 2.13 日志记录 ============
// 2.13 日志辅助函数


fn run_test_2_11_2_12_2_13(api: &TraderApi, rx: &Receiver<Event>) -> Result<(), Box<dyn std::error::Error>> {
    require_loop_trading_allowed()?;
    if wait_event(rx, Duration::from_secs(10), |e| matches!(e, Event::Connected)).is_none() {
        return Err("10 秒内未连接".into());
    }
    println!("=== 2.11/2.12/2.13 已连接 ===");
    log_to_file("系统运行: 连接成功");
    
    let (front_id, session_id) = open_session(api, rx)?;
    log_to_file(&format!("交易日志: 登录并结算完成 FrontID={} SessionID={}", front_id, session_id));

    println!("\n========== 2.11 暂停交易 ==========");
    let trading_enabled = false; // 强制关闭
    println!("[设置] trading_enabled = {}", trading_enabled);
    log_to_file("监测日志: trading_enabled 切换为 false");

    if !trading_enabled {
        println!("[BLOCK] 已暂停交易，拦截下达开仓指令");
        log_to_file("错误提示日志: [BLOCK] 暂停交易拦截开仓指令");
    } else {
        println!("[PASS] 允许下达指令");
    }
    std::thread::sleep(Duration::from_secs(3));

    println!("\n========== 2.12 批量撤单 ==========");
    let mut orders_to_cancel = Vec::new();
    
    // 先挂 3 笔单
    for i in 1..=3 {
        let order_ref = format!("9{}", i);
        let mut order = CThostFtdcInputOrderField::default();
        copy_str(&mut order.BrokerID, broker());
        copy_str(&mut order.InvestorID, user());
        copy_str(&mut order.InstrumentID, "al2612");
        copy_str(&mut order.ExchangeID, EXCHANGE);
        copy_str(&mut order.OrderRef, &order_ref);
        order.Direction = THOST_FTDC_D_Buy as i8;
        order.CombOffsetFlag[0] = THOST_FTDC_OF_Open as i8;
        order.CombHedgeFlag[0] = THOST_FTDC_HF_Speculation as i8;
        order.OrderPriceType = THOST_FTDC_OPT_LimitPrice as i8;
        order.LimitPrice = 22550.0;
        order.VolumeTotalOriginal = 1;
        order.TimeCondition = THOST_FTDC_TC_GFD as i8;
        order.VolumeCondition = THOST_FTDC_VC_AV as i8;
        order.ContingentCondition = THOST_FTDC_CC_Immediately as i8;
        order.ForceCloseReason = THOST_FTDC_FCC_NotForceClose as i8;
        order.IsAutoSuspend = 0;
        order.UserForceClose = 0;

        println!("[挂单] OrderRef={}", order_ref);
        log_to_file(&format!("交易日志: 报单 OrderRef={} al2612 22550.0 买开 1手", order_ref));
        
        let ret = api.req_order_insert(&mut order, 400 + i);
        if ret != 0 { return Err(format!("req_order_insert 失败 ret={}", ret).into()); }

        let deadline = Instant::now() + Duration::from_secs(5);
        loop {
            let remaining = deadline.saturating_duration_since(Instant::now());
            if remaining.is_zero() { break; }
            match rx.recv_timeout(remaining) {
                Ok(Event::RtnOrder { sys_id, status: _, .. }) if !sys_id.is_empty() => {
                    println!("  -> 成功 sys_id={}", sys_id);
                    orders_to_cancel.push(order_ref.clone());
                    log_to_file(&format!("交易日志: 委托回报 OrderRef={} sys_id={}", order_ref, sys_id));
                    break;
                }
                Ok(_) => {}
                Err(_) => break,
            }
        }
    }
    std::thread::sleep(Duration::from_secs(2));

    println!("\n[批量撤单] 开始撤掉上述 {} 笔委托", orders_to_cancel.len());
    for (idx, order_ref) in orders_to_cancel.iter().enumerate() {
        let mut action = CThostFtdcInputOrderActionField::default();
        copy_str(&mut action.BrokerID, broker());
        copy_str(&mut action.InvestorID, user());
        copy_str(&mut action.InstrumentID, "al2612");
        copy_str(&mut action.ExchangeID, EXCHANGE);
        copy_str(&mut action.OrderRef, order_ref);
        action.FrontID = front_id;
        action.SessionID = session_id;
        action.ActionFlag = THOST_FTDC_AF_Delete as i8;
        
        let ret = api.req_order_action(&mut action, 500 + idx as i32);
        if ret != 0 { return Err(format!("req_order_action 失败 ret={}", ret).into()); }
        log_to_file(&format!("交易日志: 批量撤单 OrderRef={}", order_ref));
    }

    // 等待撤单完成
    let deadline = Instant::now() + Duration::from_secs(10);
    let mut cancel_count = 0;
    while Instant::now() < deadline && cancel_count < orders_to_cancel.len() {
        if let Ok(Event::RtnOrder { status, .. }) = rx.recv_timeout(Duration::from_millis(500)) {
            if status == THOST_FTDC_OST_Canceled as i8 {
                cancel_count += 1;
                println!("  -> 已撤 1 笔，累计已撤 {}/{}", cancel_count, orders_to_cancel.len());
            }
        }
    }

    println!("\n========== 2.13 日志记录 ==========");
    println!("系统日志已写入: logs/ctp_test.log");
    println!("包含: 系统运行、交易日志、监测日志、错误提示日志");
    log_to_file("系统运行: 2.11/2.12/2.13 测试结束");

    println!("\n=== 2.11/2.12/2.13 全部完成 ===");
    Ok(())
}

// ============ 入口 ============


const ORDER_REF: &str = "1";


