// ============ 字符串工具 ============
fn copy_str(buf: &mut [c_char], s: &str) {
    let bytes = s.as_bytes();
    let n = bytes.len().min(buf.len().saturating_sub(1));
    for i in 0..n { buf[i] = bytes[i] as c_char; }
    if n < buf.len() { buf[n] = 0; }
}

fn read_str(buf: &[c_char]) -> String {
    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
    let bytes: Vec<u8> = buf[..end].iter().map(|&b| b as u8).collect();
    if bytes.is_empty() { return String::new(); }
    let (decoded, _, had_errors) = encoding_rs::GB18030.decode(&bytes);
    if had_errors {
        String::from_utf8_lossy(&bytes).trim().to_string()
    } else {
        decoded.trim().to_string()
    }
}

fn rsp_err(info: Option<&CThostFtdcRspInfoField>) -> Option<(i32, String)> {
    info.and_then(|i| if i.ErrorID != 0 { Some((i.ErrorID, read_str(&i.ErrorMsg))) } else { None })
}

// ============ 事件 ============
#[derive(Debug)]
enum Event {
    Connected,
    Disconnected,
    AuthRsp(Option<(i32, String)>),
    LoginRsp { err: Option<(i32, String)>, front_id: i32, session_id: i32, trading_day: String },
    SettleRsp(Option<(i32, String)>),
    InsertRsp(Option<(i32, String)>),
    ActionRsp(Option<(i32, String)>),
    RtnOrder { sys_id: String, status: i8, traded: i32, total: i32 },
    RtnTrade { price: f64, volume: i32 },
    ErrRtnInsert(Option<(i32, String)>),
    ErrRtnAction(Option<(i32, String)>),
}

struct MySpi { tx: Sender<Event> }

impl TraderSpi for MySpi {
    fn on_front_connected(&mut self) { let _ = self.tx.send(Event::Connected); }
    fn on_front_disconnected(&mut self, r: i32) {
        eprintln!("[SPI] on_front_disconnected reason={}  <-- C++ 回调已触发", r);
        let _ = self.tx.send(Event::Disconnected);
    }
    fn on_rsp_authenticate(&mut self, _rsp: Option<&CThostFtdcRspAuthenticateField>, info: Option<&CThostFtdcRspInfoField>, _req: i32, _last: bool) {
        let _ = self.tx.send(Event::AuthRsp(rsp_err(info)));
    }
    fn on_rsp_user_login(&mut self, rsp: Option<&CThostFtdcRspUserLoginField>, info: Option<&CThostFtdcRspInfoField>, _req: i32, _last: bool) {
        let err = rsp_err(info);
        let (f, s, d) = rsp.map(|r| (r.FrontID, r.SessionID, read_str(&r.TradingDay))).unwrap_or((0, 0, String::new()));
        let _ = self.tx.send(Event::LoginRsp { err, front_id: f, session_id: s, trading_day: d });
    }
    fn on_rsp_settlement_info_confirm(&mut self, _rsp: Option<&CThostFtdcSettlementInfoConfirmField>, info: Option<&CThostFtdcRspInfoField>, _req: i32, _last: bool) {
        let _ = self.tx.send(Event::SettleRsp(rsp_err(info)));
    }
    fn on_rsp_order_insert(&mut self, _o: Option<&CThostFtdcInputOrderField>, info: Option<&CThostFtdcRspInfoField>, _req: i32, _last: bool) {
        let _ = self.tx.send(Event::InsertRsp(rsp_err(info)));
    }
    fn on_rsp_order_action(&mut self, _a: Option<&CThostFtdcInputOrderActionField>, info: Option<&CThostFtdcRspInfoField>, _req: i32, _last: bool) {
        let _ = self.tx.send(Event::ActionRsp(rsp_err(info)));
    }
    fn on_err_rtn_order_insert(&mut self, _o: Option<&CThostFtdcInputOrderField>, info: Option<&CThostFtdcRspInfoField>) {
        let _ = self.tx.send(Event::ErrRtnInsert(rsp_err(info)));
    }
    fn on_err_rtn_order_action(&mut self, _a: Option<&CThostFtdcOrderActionField>, info: Option<&CThostFtdcRspInfoField>) {
        let _ = self.tx.send(Event::ErrRtnAction(rsp_err(info)));
    }
    fn on_rtn_order(&mut self, order: Option<&CThostFtdcOrderField>) {
        if let Some(o) = order {
            let _ = self.tx.send(Event::RtnOrder {
                sys_id: read_str(&o.OrderSysID),
                status: o.OrderStatus,
                traded: o.VolumeTraded,
                total: o.VolumeTotal,
            });
        }
    }
    fn on_rtn_trade(&mut self, trade: Option<&CThostFtdcTradeField>) {
        if let Some(t) = trade {
            let _ = self.tx.send(Event::RtnTrade { price: t.Price, volume: t.Volume });
        }
    }
}

fn wait_event<F: Fn(&Event) -> bool>(rx: &Receiver<Event>, timeout: Duration, pred: F) -> Option<Event> {
    let deadline = Instant::now() + timeout;
    loop {
        let remaining = deadline.saturating_duration_since(Instant::now());
        if remaining.is_zero() { return None; }
        match rx.recv_timeout(remaining) {
            Ok(ev) => {
                println!("[EVENT] {:?}", ev);
                if pred(&ev) { return Some(ev); }
            }
            Err(_) => return None,
        }
    }
}

// ============ 公共会话：认证 + 登录 + 结算确认 ============
fn open_session(api: &TraderApi, rx: &Receiver<Event>) -> Result<(i32, i32), String> {
    // 认证
    let mut auth = CThostFtdcReqAuthenticateField::default();
    copy_str(&mut auth.BrokerID, BROKER);
    copy_str(&mut auth.UserID, USER);
    copy_str(&mut auth.AppID, APPID);
    copy_str(&mut auth.AuthCode, AUTHCODE);
    println!("[AUTH REQ] ret={}", api.req_authenticate(&mut auth, 1));
    match wait_event(rx, Duration::from_secs(10), |e| matches!(e, Event::AuthRsp(..))) {
        Some(Event::AuthRsp(None)) => println!("[AUTH SUCCESS]"),
        Some(Event::AuthRsp(Some((id, m)))) => return Err(format!("认证: {} {}", id, m)),
        _ => return Err("认证超时".into()),
    }

    // 登录
    let mut login = CThostFtdcReqUserLoginField::default();
    copy_str(&mut login.BrokerID, BROKER);
    copy_str(&mut login.UserID, USER);
    copy_str(&mut login.Password, PASSWORD);
    println!("[LOGIN REQ] ret={}", api.req_user_login(&mut login, 2));
    let (front_id, session_id) = match wait_event(rx, Duration::from_secs(15), |e| matches!(e, Event::LoginRsp { .. })) {
        Some(Event::LoginRsp { err: None, front_id, session_id, trading_day }) => {
            println!("[LOGIN SUCCESS] TradingDay={} FrontID={} SessionID={}", trading_day, front_id, session_id);
            (front_id, session_id)
        }
        Some(Event::LoginRsp { err: Some((id, m)), .. }) => return Err(format!("登录: {} {}", id, m)),
        _ => return Err("登录超时".into()),
    };

    // 结算确认（每天必须，否则报单 ErrorID=42）
    let mut settle = CThostFtdcSettlementInfoConfirmField::default();
    copy_str(&mut settle.BrokerID, BROKER);
    copy_str(&mut settle.InvestorID, USER);
    println!("[SETTLE REQ] ret={}", api.req_settlement_info_confirm(&mut settle, 3));
    match wait_event(rx, Duration::from_secs(10), |e| matches!(e, Event::SettleRsp(..))) {
        Some(Event::SettleRsp(None)) => println!("[SETTLE SUCCESS]"),
        Some(Event::SettleRsp(Some((id, m)))) => return Err(format!("结算: {} {}", id, m)),
        _ => return Err("结算确认超时".into()),
    }

    Ok((front_id, session_id))
}

